---
import { copy, experience, games, otherGames, personalProjects, professionalProjects, type Locale } from '../data/portfolio';
import PersonalProjectCard from './PersonalProjectCard.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/projects/me.png';
import logoAR from '../assets/logoAR.png';
import { projectFilters, professionalContext } from '../data/projectPresentation';
import '../styles/global.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const otherLocale = locale === 'en' ? 'es' : 'en';
const otherPath = locale === 'en' ? '/es/' : '/';
const currentPath = locale === 'en' ? '/' : '/es/';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Save section links before the browser performs its initial fragment jump.
      if (/^#(main|about|personal|work|experience|contact|personal-projects|games|other-games)$/.test(location.hash)) {
        document.documentElement.dataset.initialSection = location.hash;
        document.documentElement.dataset.scrollRestoration = history.scrollRestoration;
        history.scrollRestoration = 'manual';
        history.replaceState(history.state, '', location.pathname + location.search);
      }
    </script>
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#f1eee6" />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="es" href="/es/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{t.title}</title>
    <noscript><style>.project-group[hidden]{display:block!important}.project-tabs{display:none!important}</style></noscript>
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={currentPath} aria-label={`Aramcode — ${locale === 'en' ? 'home' : 'inicio'}`}>
          <span class="brand-mark">A<span class="brand-dot">.</span></span>
          <span class="brand-name">ANDRÉS<br />RAMÍREZ</span>
        </a>
        <nav class="desktop-nav" aria-label={t.mainNavigation}>
          <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
          <a href="#about">{t.nav.about}</a>
          <a href="#personal">{t.nav.personal}</a>
          <a href="#work">{t.nav.work}</a>
          <a href="#experience">{t.nav.experience}</a>
        </nav>
        <div class="header-actions">
          <a class="language-link" href={otherPath} hreflang={otherLocale} aria-label={t.language}>{otherLocale.toUpperCase()} <span aria-hidden="true">↗</span></a>
          <a class="header-contact" href="#contact">{t.nav.contact} <span aria-hidden="true">↗</span></a>
          <details class="mobile-menu">
            <summary aria-label={t.menu}><span></span><span></span></summary>
            <nav aria-label={t.mobileNavigation}>
              <a href="#about">{t.nav.about}</a>
              <a href="#personal">{t.nav.personal}</a>
              <a href="#work">{t.nav.work}</a>
              <a href="#experience">{t.nav.experience}</a>
              <a href="#contact">{t.nav.contact}</a>
            </nav>
          </details>
        </div>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <div class="availability"><span class="status-dot"></span>{t.availability}</div>
            <p class="hero-intro">{t.intro} <span>Andrés Ramírez.</span></p>
            <h1 id="hero-title">{t.heroLine}<br /><em>{t.heroAccent}</em></h1>
            <p class="hero-description">{t.heroDescription}</p>
            <div class="hero-actions">
              <a class="button button-dark" href="#personal">{t.explore}<span aria-hidden="true">↗</span></a>
              <a class="text-link" href="mailto:gandres.ramirez@gmail.com">{t.getInTouch}<span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="hero-art" data-hero-playground>
            <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
            <button type="button" class="art-core" data-orbit-play aria-label={locale === 'en' ? 'Play with the orbits' : 'Jugar con las órbitas'} aria-describedby="orbit-hint"><Image src={logoAR} alt="" format="webp" quality={92} /></button>
            <span class="art-cross cross-one" aria-hidden="true">✳</span><span class="art-cross cross-two" aria-hidden="true">✳</span>
            <span class="art-caption">ENGINEERING / CURIOSITY / PLAY</span>
            <span class="orbit-particle particle-one" aria-hidden="true"></span><span class="orbit-particle particle-two" aria-hidden="true"></span>
            <p class="orbit-hint" id="orbit-hint">{locale === 'en' ? 'Move to explore. Tap to set it in motion.' : 'Mueve para explorar. Pulsa para activar las órbitas.'}</p>
          </div>
          <a class="scroll-cue" href="#about"><span class="scroll-line"></span>{t.scroll}</a>
          <span class="hero-index">PORTFOLIO / {year}</span>
        </section>

        <section class="section about-section" id="about" aria-labelledby="about-title">
          <div class="section-label"><span>{t.aboutKicker}</span><span class="section-rule"></span></div>
          <div class="about-grid">
            <div class="about-copy">
              <h2 id="about-title">{t.aboutTitle}</h2>
              <p>{t.aboutBody}</p>
              <div class="about-discipline"><span class="asterisk">✳</span>{t.aboutAside}</div>
            </div>
            <div class="portrait-frame">
              <Image src={portrait} alt={t.portraitHint} format="webp" quality={86} loading="lazy" />
              <span class="portrait-note">{t.portrait}</span>
            </div>
          </div>
        </section>

        <section class="section personal-section" id="personal" aria-labelledby="personal-title">
          <div class="section-label"><span>{t.personalKicker}</span><span class="section-rule"></span></div>
          <div class="section-heading"><h2 id="personal-title">{t.personalTitle}</h2><p>{t.personalDescription}</p></div>
          <div class="project-tabs" role="tablist" aria-label={locale === 'en' ? 'Personal project categories' : 'Categorías de proyectos personales'}>
            <button type="button" role="tab" id="projects-tab" aria-controls="personal-projects" aria-selected="true" tabindex="0" data-project-tab><span>01</span>{t.projectsGroup} <b>{String(personalProjects.length).padStart(2, '0')}</b></button>
            <button type="button" role="tab" id="games-tab" aria-controls="games" aria-selected="false" tabindex="-1" data-project-tab><span>02</span>{t.gamesGroup} <b>{String(games.length).padStart(2, '0')}</b></button>
            <button type="button" role="tab" id="other-games-tab" aria-controls="other-games" aria-selected="false" tabindex="-1" data-project-tab><span>03</span>{t.otherGamesGroup} <b>{String(otherGames.length).padStart(2, '0')}</b></button>
          </div>
          <div class="project-panels" data-project-panels>
          <div class="project-group" id="personal-projects" role="tabpanel" aria-labelledby="projects-tab" tabindex="0" data-project-panel>
            <div class="project-group-heading"><span>01 / {t.projectsGroup}</span><span>{String(personalProjects.length).padStart(2, '0')}</span></div>
            <div class="project-filter-bar" data-project-filters hidden>
              <div class="project-filter-options" role="group" aria-label={locale === 'en' ? 'Filter projects' : 'Filtrar proyectos'}>{projectFilters.map((filter) => <button type="button" data-project-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'}>{filter[locale]}</button>)}</div>
              <span class="project-filter-count" data-filter-count aria-live="polite" data-count-label={locale === 'en' ? 'projects' : 'proyectos'}>{personalProjects.length} / {personalProjects.length} {t.projectsGroup.toLowerCase()}</span>
            </div>
            <div class="project-gallery project-gallery-main">{personalProjects.map((project, index) => <PersonalProjectCard project={project} locale={locale} index={index + 1} featured={index === 0} />)}</div>
          </div>
          <div class="project-group" id="games" role="tabpanel" aria-labelledby="games-tab" tabindex="0" data-project-panel hidden>
            <div class="project-group-heading"><span>02 / {t.gamesGroup}</span><span>{String(games.length).padStart(2, '0')}</span></div>
            <div class="project-gallery">{games.map((project, index) => <PersonalProjectCard project={project} locale={locale} index={index + 1} />)}</div>
          </div>
          <div class="project-group" id="other-games" role="tabpanel" aria-labelledby="other-games-tab" tabindex="0" data-project-panel hidden>
            <div class="project-group-heading"><span>03 / {t.otherGamesGroup}</span><span>{String(otherGames.length).padStart(2, '0')}</span></div>
            <div class="project-gallery">{otherGames.map((project, index) => <PersonalProjectCard project={project} locale={locale} index={index + 1} />)}</div>
          </div>
          </div>
        </section>

        <section class="section work-section" id="work" aria-labelledby="work-title">
          <div class="section-label"><span>{t.workKicker}</span><span class="section-rule"></span></div>
          <div class="section-heading"><h2 id="work-title">{t.workTitle}</h2><p>{t.workDescription}</p></div>
          <div class="work-grid">
            {professionalProjects.map((project, index) => (
              <article class="work-card">
                {project.url ? (
                  <a class="work-image" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${t.visitSite}: ${project.name}`}>
                    <img src={project.image} alt="" loading="lazy" />
                    <span class="image-arrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <div class="work-image"><img src={project.image} alt="" loading="lazy" /></div>
                )}
                <div class="work-meta"><span>0{index + 1} / {project.name}</span>{project.url && <a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${t.visitSite}: ${project.name}`}>↗</a>}</div>
                <p class="work-stack">{project.stack.join(' · ')}</p>
                <details class="work-details">
                  <summary>{locale === 'en' ? 'My contribution' : 'Mi participación'}<span aria-hidden="true">+</span></summary>
                  <div class="work-details-content"><p>{professionalContext[project.name]?.[locale]}</p><h3>{locale === 'en' ? 'Technologies' : 'Tecnologías'}</h3><p>{project.stack.join(' · ')}</p>{project.url && <a href={project.url} target="_blank" rel="noopener noreferrer">{t.visitSite} ↗</a>}</div>
                </details>
              </article>
            ))}
          </div>
        </section>

        <section class="section experience-section" id="experience" aria-labelledby="experience-title">
          <div class="section-label"><span>{t.experienceKicker}</span><span class="section-rule"></span></div>
          <div class="experience-grid"><h2 id="experience-title">{t.experienceTitle}</h2><div class="experience-list">
            {experience.map((job, index) => (
              <article class="experience-item"><span class="experience-number">0{index + 1}</span><div><h3>{job.company}</h3><p class="experience-role">{job.role[locale]}</p><p class="experience-description">{job.description[locale]}</p></div><span class="experience-plus" aria-hidden="true">↗</span></article>
            ))}
          </div></div>
        </section>

        <section class="contact-section" id="contact" aria-labelledby="contact-title">
          <div class="section-label"><span>{t.contactKicker}</span><span class="section-rule"></span></div>
          <div class="contact-content"><div><h2 id="contact-title">{t.contactTitle}</h2><p>{t.contactBody}</p></div><a href="mailto:gandres.ramirez@gmail.com" class="contact-arrow" aria-label={t.emailMe}>↗</a></div>
          <a class="contact-email" href="mailto:gandres.ramirez@gmail.com">gandres.ramirez@gmail.com</a>
        </section>
      </main>

      <footer class="site-footer">
        <span>{t.footer}</span>
        <div class="footer-social">
          <a href="https://www.linkedin.com/in/gonzaloandresramirez" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
            <span>LinkedIn ↗</span>
          </a>
          <a href="https://dev.to/gara501" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6l.02 2.44.04 2.45.56-.02c.41 0 .63-.07.83-.26.24-.24.26-.36.26-2.2 0-1.91-.02-1.96-.29-2.18zM0 4.94v14.12h24V4.94H0zM8.56 15.3c-.44.58-1.06.77-2.53.77H4.71V8.53h1.4c1.67 0 2.16.18 2.6.9.27.43.29.6.32 2.57.05 2.23-.02 2.73-.47 3.3zm5.09-5.47h-2.47v1.77h1.52v1.28l-.72.04-.75.03v1.77l1.22.03 1.2.04v1.28h-1.6c-1.53 0-1.6-.01-1.87-.3l-.3-.28v-3.16c0-3.02.01-3.18.25-3.48.23-.31.25-.31 1.88-.31h1.64v1.3zm4.68 5.45c-.17.43-.64.79-1 .79-.18 0-.45-.15-.67-.39-.32-.32-.45-.63-.82-2.08l-.9-3.39-.45-1.67h.76c.4 0 .75.02.75.05 0 .06 1.16 4.54 1.26 4.83.04.15.32-.7.73-2.3l.66-2.52.74-.04c.4-.02.73 0 .73.04 0 .14-1.67 6.38-1.8 6.68z"/></svg>
            <span>Blog ↗</span>
          </a>
          <a href="https://github.com/gara501" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            <span>GitHub ↗</span>
          </a>
        </div>
        <a href="#main" aria-label={t.backToTop}>↑</a>
      </footer>
    </div>
    <a class="back-to-top" href="#main" data-back-to-top hidden aria-label={t.backToTop}><span aria-hidden="true">↑</span><span>{t.backToTop}</span></a>
    <dialog class="project-detail-dialog" data-detail-dialog aria-labelledby="project-detail-dialog-title">
      <button type="button" class="project-lightbox-close" data-detail-close autofocus aria-label={locale === 'en' ? 'Close project' : 'Cerrar proyecto'}>×</button>
      <div data-detail-content></div>
    </dialog>
    <dialog class="project-lightbox" aria-labelledby="project-preview-title" data-project-lightbox>
      <div class="project-lightbox-header">
        <div><span class="project-lightbox-kicker">{locale === 'en' ? 'Project preview' : 'Vista del proyecto'}</span><h2 id="project-preview-title"></h2></div>
        <button class="project-lightbox-close" type="button" data-preview-close autofocus aria-label={locale === 'en' ? 'Close preview' : 'Cerrar vista'}>×</button>
      </div>
      <div class="project-lightbox-stage"><img data-preview-image alt="" /></div>
      <div class="project-lightbox-footer">
        <button type="button" data-preview-previous aria-label={locale === 'en' ? 'Previous project' : 'Proyecto anterior'}>← <span>{locale === 'en' ? 'Previous' : 'Anterior'}</span></button>
        <span data-preview-count aria-live="polite"></span>
        <button type="button" data-preview-next aria-label={locale === 'en' ? 'Next project' : 'Proyecto siguiente'}><span>{locale === 'en' ? 'Next' : 'Siguiente'}</span> →</button>
      </div>
    </dialog>
    <script>import '../scripts/portfolio';</script>
  </body>
</html>
