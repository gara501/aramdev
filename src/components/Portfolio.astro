---
import { copy, experience, games, otherGames, personalProjects, professionalProjects, type Locale } from '../data/portfolio';
import PersonalProjectCard from './PersonalProjectCard.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/projects/me.png';
import '../styles/global.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const otherLocale = locale === 'en' ? 'es' : 'en';
const otherPath = locale === 'en' ? '/es/' : '/';
const currentPath = locale === 'en' ? '/' : '/es/';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#f1eee6" />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="es" href="/es/" />
    <link rel="alternate" hreflang="x-default" href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{t.title}</title>
    <noscript><style>.project-group[hidden]{display:block!important}.project-tabs{display:none!important}</style></noscript>
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={currentPath} aria-label={`Aramcode — ${locale === 'en' ? 'home' : 'inicio'}`}>
          <span class="brand-mark">A<span class="brand-dot">.</span></span>
          <span class="brand-name">ANDRÉS<br />RAMÍREZ</span>
        </a>
        <nav class="desktop-nav" aria-label={t.mainNavigation}>
          <a href="#about">{t.nav.about}</a>
          <a href="#personal">{t.nav.personal}</a>
          <a href="#work">{t.nav.work}</a>
          <a href="#experience">{t.nav.experience}</a>
        </nav>
        <div class="header-actions">
          <a class="language-link" href={otherPath} hreflang={otherLocale} aria-label={t.language}>{otherLocale.toUpperCase()} <span aria-hidden="true">↗</span></a>
          <a class="header-contact" href="#contact">{t.nav.contact} <span aria-hidden="true">↗</span></a>
          <details class="mobile-menu">
            <summary aria-label={t.menu}><span></span><span></span></summary>
            <nav aria-label={t.mobileNavigation}>
              <a href="#about">{t.nav.about}</a>
              <a href="#personal">{t.nav.personal}</a>
              <a href="#work">{t.nav.work}</a>
              <a href="#experience">{t.nav.experience}</a>
              <a href="#contact">{t.nav.contact}</a>
            </nav>
          </details>
        </div>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <div class="availability"><span class="status-dot"></span>{t.availability}</div>
            <p class="hero-intro">{t.intro} <span>Andrés Ramírez.</span></p>
            <h1 id="hero-title">{t.heroLine}<br /><em>{t.heroAccent}</em></h1>
            <p class="hero-description">{t.heroDescription}</p>
            <div class="hero-actions">
              <a class="button button-dark" href="#personal">{t.explore}<span aria-hidden="true">↗</span></a>
              <a class="text-link" href="mailto:gandres.ramirez@gmail.com">{t.getInTouch}<span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
            <div class="art-core"><span>A</span><i></i></div>
            <span class="art-cross cross-one">✳</span><span class="art-cross cross-two">✳</span>
            <span class="art-caption">ENGINEERING / CURIOSITY / PLAY</span>
          </div>
          <a class="scroll-cue" href="#about"><span class="scroll-line"></span>{t.scroll}</a>
          <span class="hero-index">PORTFOLIO / {year}</span>
        </section>

        <section class="section about-section" id="about" aria-labelledby="about-title">
          <div class="section-label"><span>{t.aboutKicker}</span><span class="section-rule"></span></div>
          <div class="about-grid">
            <div class="about-copy">
              <h2 id="about-title">{t.aboutTitle}</h2>
              <p>{t.aboutBody}</p>
              <div class="about-discipline"><span class="asterisk">✳</span>{t.aboutAside}</div>
            </div>
            <div class="portrait-frame">
              <Image src={portrait} alt={t.portraitHint} format="webp" quality={86} loading="lazy" />
              <span class="portrait-note">{t.portrait}</span>
            </div>
          </div>
        </section>

        <section class="section personal-section" id="personal" aria-labelledby="personal-title">
          <div class="section-label"><span>{t.personalKicker}</span><span class="section-rule"></span></div>
          <div class="section-heading"><h2 id="personal-title">{t.personalTitle}</h2><p>{t.personalDescription}</p></div>
          <div class="project-tabs" role="tablist" aria-label={locale === 'en' ? 'Personal project categories' : 'Categorías de proyectos personales'}>
            <button type="button" role="tab" id="projects-tab" aria-controls="personal-projects" aria-selected="true" tabindex="0" data-project-tab><span>01</span>{t.projectsGroup} <b>{String(personalProjects.length).padStart(2, '0')}</b></button>
            <button type="button" role="tab" id="games-tab" aria-controls="games" aria-selected="false" tabindex="-1" data-project-tab><span>02</span>{t.gamesGroup} <b>{String(games.length).padStart(2, '0')}</b></button>
            <button type="button" role="tab" id="other-games-tab" aria-controls="other-games" aria-selected="false" tabindex="-1" data-project-tab><span>03</span>{t.otherGamesGroup} <b>{String(otherGames.length).padStart(2, '0')}</b></button>
          </div>
          <div class="project-group" id="personal-projects" role="tabpanel" aria-labelledby="projects-tab" tabindex="0" data-project-panel>
            <div class="project-group-heading"><span>01 / {t.projectsGroup}</span><span>{String(personalProjects.length).padStart(2, '0')}</span></div>
            <div class="project-gallery project-gallery-main">{personalProjects.map((project, index) => <PersonalProjectCard project={project} locale={locale} index={index + 1} featured={index === 0} />)}</div>
          </div>
          <div class="project-group" id="games" role="tabpanel" aria-labelledby="games-tab" tabindex="0" data-project-panel hidden>
            <div class="project-group-heading"><span>02 / {t.gamesGroup}</span><span>{String(games.length).padStart(2, '0')}</span></div>
            <div class="project-gallery">{games.map((project, index) => <PersonalProjectCard project={project} locale={locale} index={index + 1} />)}</div>
          </div>
          <div class="project-group" id="other-games" role="tabpanel" aria-labelledby="other-games-tab" tabindex="0" data-project-panel hidden>
            <div class="project-group-heading"><span>03 / {t.otherGamesGroup}</span><span>{String(otherGames.length).padStart(2, '0')}</span></div>
            <div class="project-gallery">{otherGames.map((project, index) => <PersonalProjectCard project={project} locale={locale} index={index + 1} />)}</div>
          </div>
        </section>

        <section class="section work-section" id="work" aria-labelledby="work-title">
          <div class="section-label"><span>{t.workKicker}</span><span class="section-rule"></span></div>
          <div class="section-heading"><h2 id="work-title">{t.workTitle}</h2><p>{t.workDescription}</p></div>
          <div class="work-grid">
            {professionalProjects.map((project, index) => (
              <article class="work-card">
                <a class="work-image" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${t.visitSite}: ${project.name}`}>
                  <img src={project.image} alt="" loading="lazy" />
                  <span class="image-arrow" aria-hidden="true">↗</span>
                </a>
                <div class="work-meta"><span>0{index + 1} / {project.name}</span><a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${t.visitSite}: ${project.name}`}>↗</a></div>
                <p class="work-stack">{project.stack.join(' · ')}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="section experience-section" id="experience" aria-labelledby="experience-title">
          <div class="section-label"><span>{t.experienceKicker}</span><span class="section-rule"></span></div>
          <div class="experience-grid"><h2 id="experience-title">{t.experienceTitle}</h2><div class="experience-list">
            {experience.map((job, index) => (
              <article class="experience-item"><span class="experience-number">0{index + 1}</span><div><h3>{job.company}</h3><p class="experience-role">{job.role[locale]}</p><p class="experience-description">{job.description[locale]}</p></div><span class="experience-plus" aria-hidden="true">↗</span></article>
            ))}
          </div></div>
        </section>

        <section class="contact-section" id="contact" aria-labelledby="contact-title">
          <div class="section-label"><span>{t.contactKicker}</span><span class="section-rule"></span></div>
          <div class="contact-content"><div><h2 id="contact-title">{t.contactTitle}</h2><p>{t.contactBody}</p></div><a href="mailto:gandres.ramirez@gmail.com" class="contact-arrow" aria-label={t.emailMe}>↗</a></div>
          <a class="contact-email" href="mailto:gandres.ramirez@gmail.com">gandres.ramirez@gmail.com</a>
        </section>
      </main>

      <footer class="site-footer"><span>{t.footer}</span><div><a href="https://github.com/gara501" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://aramhack.wordpress.com/" target="_blank" rel="noopener noreferrer">Blog ↗</a><a href="https://www.youtube.com/channel/UCc9WtBjWQ5mgtdzqqQyv_xQ" target="_blank" rel="noopener noreferrer">YouTube ↗</a></div><a href="#main" aria-label={t.backToTop}>↑</a></footer>
    </div>
    <script>import '../scripts/portfolio';</script>
  </body>
</html>
